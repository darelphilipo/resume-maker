{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": {
      "*": "allow",
      ".github/workflows/*": "deny",
      "opencode.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "shell": {
      "*": "deny",
      "npm run typecheck*": "allow",
      "npm test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npm install*": "allow",
      "npm uninstall*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow"
    },
    "webfetch": "deny"
  }
}
